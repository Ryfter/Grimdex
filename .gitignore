# Local agent session state (not knowledge — config snapshots belong in config/)
# Exception: the committed repo permission settings the scheduled routines rely on.
.claude/*
!.claude/settings.json
# Scheduled-routine transcripts (durable record = the committed logs)
logs/

# Instance-only config (never published): the rules-file mode choice, and the publish
# scrubber's identifier list (the list of what is personal is itself personal).
config/grimdex-mode.json
config/publish-scrub.json
